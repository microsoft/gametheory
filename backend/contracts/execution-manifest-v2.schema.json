        "ends_at"
      ],
      "title": "PreparationWindow",
      "type": "object"
    },
    "PriorResultReference": {
      "additionalProperties": false,
      "description": "A required declared result of a guaranteed earlier operation; never evaluated here.",
      "properties": {
        "source_step_id": {
          "format": "uuid",
          "title": "Source Step Id",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "source_step_id",
        "field"
      ],
      "title": "PriorResultReference",
      "type": "object"
    },
    "RecoveryBinding": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "format": "uuid",
          "title": "Step Id",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/OperationBinding"
        },
        "parameters": {
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "maxLength": 4000,
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/PriorResultReference"
                }
              ]
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "ownership_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Ownership Parameter",
          "type": "string"
        },
        "version_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Version Parameter",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "binding",
        "parameters",
        "ownership_parameter",
        "version_parameter"
      ],
      "title": "RecoveryBinding",
      "type": "object"
    },
    "RestInvocation": {
      "additionalProperties": false,
      "description": "Description only: expected_version maps to future strong If-Match.\n\nIt is a string with explicit max_length and a bare, unquoted opaque value.\nThe future dispatcher owns Idempotency-Key; catalogs cannot supply headers.\nRemaining non-path parameters are GET query fields or a flat write body.",
      "properties": {
        "kind": {
          "const": "rest",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "method",
        "path"
      ],
      "title": "RestInvocation",
      "type": "object"
    },
    "ScenarioContent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Title",
          "type": "string"
        },
        "document": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Document",
          "type": "object"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "maxItems": 500,
          "title": "Objectives",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/FlowNode"
          },
          "maxItems": 5000,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "maxItems": 10000,
          "title": "Edges",
          "type": "array"
        },
        "asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 5000,
          "title": "Asset Ids",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "ScenarioContent",
      "type": "object"
    },
    "ScenarioPin": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "revision_version": {
          "minimum": 1,
          "title": "Revision Version",
          "type": "integer"
        },
        "content": {
          "$ref": "#/$defs/ScenarioContent"
        }
      },
      "required": [
