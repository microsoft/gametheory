        "revision_version",
        "content"
      ],
      "title": "ScenarioPin",
      "type": "object"
    },
    "SqlInvocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sql",
          "title": "Kind",
          "type": "string"
        },
        "procedure": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}\\.[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Procedure",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "procedure"
      ],
      "title": "SqlInvocation",
      "type": "object"
    },
    "StepCondition": {
      "additionalProperties": false,
      "properties": {
        "source_step_id": {
          "format": "uuid",
          "title": "Source Step Id",
          "type": "string"
        },
        "result_field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Result Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "if_true": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 200,
          "title": "If True",
          "type": "array"
        },
        "if_false": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 200,
          "title": "If False",
          "type": "array"
        }
      },
      "required": [
        "source_step_id",
        "result_field",
        "operator",
        "value"
      ],
      "title": "StepCondition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "exercise-execution/v2",
      "default": "exercise-execution/v2",
