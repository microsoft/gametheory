{
  "$defs": {
    "GraphInvocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "graph",
          "title": "Kind",
          "type": "string"
        },
        "template_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Template Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "template_key"
      ],
      "title": "GraphInvocation",
      "type": "object"
    },
    "OperationDefinition": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$",
          "title": "Version",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Label",
          "type": "string"
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "notify"
          ],
          "title": "Effect",
          "type": "string"
        },
        "invocation": {
          "discriminator": {
            "mapping": {
              "graph": "#/$defs/GraphInvocation",
              "rest": "#/$defs/RestInvocation",
              "sql": "#/$defs/SqlInvocation"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SqlInvocation"
            },
            {
              "$ref": "#/$defs/RestInvocation"
            },
            {
              "$ref": "#/$defs/GraphInvocation"
            }
          ],
          "title": "Invocation"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/OperationField"
          },
          "maxItems": 100,
          "title": "Parameters",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/OperationField"
          },
          "maxItems": 100,
          "title": "Results",
          "type": "array"
        },
        "recovery": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Recovery",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version",
        "label",
        "effect",
        "invocation",
        "parameters",
        "results",
        "recovery"
      ],
      "title": "OperationDefinition",
      "type": "object"
    },
    "OperationField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "uuid",
            "datetime"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "max_length": {
          "anyOf": [
            {
              "maximum": 4000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "OperationField",
      "type": "object"
    },
    "RestInvocation": {
      "additionalProperties": false,
      "description": "Description only: expected_version maps to future strong If-Match.\n\nIt is a string with explicit max_length and a bare, unquoted opaque value.\nThe future dispatcher owns Idempotency-Key; catalogs cannot supply headers.\nRemaining non-path parameters are GET query fields or a flat write body.",
      "properties": {
        "kind": {
          "const": "rest",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "method",
        "path"
      ],
      "title": "RestInvocation",
      "type": "object"
    },
    "SqlInvocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sql",
          "title": "Kind",
          "type": "string"
        },
        "procedure": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}\\.[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Procedure",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "procedure"
      ],
      "title": "SqlInvocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "operation-catalog/v1",
      "default": "operation-catalog/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Name",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/OperationDefinition"
      },
      "maxItems": 200,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "name",
    "operations"
  ],
  "title": "OperationCatalog",
  "type": "object"
}
