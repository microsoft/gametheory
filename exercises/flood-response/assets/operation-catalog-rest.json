{
  "schema_version": "operation-catalog/v1",
  "name": "Synthetic flood lab — REST descriptions",
  "operations": [
    {
      "key": "resource-request.create",
      "version": "1",
      "label": "Create a synthetic resource request",
      "effect": "write",
      "invocation": {
        "kind": "rest",
        "method": "POST",
        "path": "/v1/runs/{run_id}/requests"
      },
      "parameters": [
        {
          "name": "run_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "shelter_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "resource_type",
          "type": "string",
          "required": true,
          "choices": [
            "cots",
            "blankets",
            "water_cases",
            "transport_seats"
          ]
        },
        {
          "name": "quantity_requested",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 10000
        },
        {
          "name": "summary",
          "type": "string",
          "required": true,
          "max_length": 240
        },
        {
          "name": "needed_by",
          "type": "datetime",
          "required": true
        }
      ],
      "results": [
        {
          "name": "request_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "run_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "shelter_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "record_version",
          "type": "string",
          "required": true,
          "max_length": 35
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "choices": [
            "open",
            "acknowledged",
            "fulfilled"
          ]
        },
        {
          "name": "quantity_requested",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 10000
        },
        {
          "name": "quantity_allocated",
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 10000
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "needed_by",
          "type": "datetime",
          "required": true
        },
        {
          "name": "outcome",
          "type": "string",
          "required": true,
          "choices": [
            "succeeded",
            "rejected",
            "failed",
            "unknown"
          ]
        },
        {
          "name": "durable_event_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "committed_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "correlation_id",
          "type": "uuid",
          "required": true
        }
      ],
      "recovery": "No automatic undo. Reconcile unknown outcomes with the identical actor, run, operation, key, payload and expected version. Operator recovery retires only unchanged seed-owned records; participant changes, other operations and durable evidence are retained. Requires the service API role, not a participant. Idempotency-Key is generated by the caller/dispatcher, never a catalog-selected input."
    },
    {
