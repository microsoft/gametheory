    {
      "key": "resource-request.milestones",
      "version": "1",
      "label": "Read authoritative request milestones",
      "effect": "read",
      "invocation": {
        "kind": "rest",
        "method": "GET",
        "path": "/v1/runs/{run_id}/requests/{request_id}/milestones"
      },
      "parameters": [
        {
          "name": "run_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "request_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "acknowledge_within_seconds",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 604800
        },
        {
          "name": "allocate_within_seconds",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 604800
        }
      ],
      "results": [
        {
          "name": "contract_version",
          "type": "string",
          "required": true,
          "choices": [
            "flood-lab-milestones/v1"
          ]
        },
        {
          "name": "request_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "run_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "record_version",
          "type": "string",
          "required": true,
          "max_length": 35
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "choices": [
