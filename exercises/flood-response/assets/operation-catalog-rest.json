            "acknowledged",
            "fulfilled"
          ]
        },
        {
          "name": "quantity_requested",
          "type": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 10000
        },
        {
          "name": "quantity_allocated",
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 10000
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "created_event_id",
          "type": "uuid",
          "required": false
        },
        {
          "name": "acknowledged",
          "type": "boolean",
          "required": true
        },
        {
          "name": "acknowledged_at",
          "type": "datetime",
          "required": false
        },
        {
