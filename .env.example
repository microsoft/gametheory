# Copy to .env in the repository root. No credentials are committed.
AZURE_CLOUD=commercial
# Required for custom: an absolute path to an explicit JSON cloud profile.
# AZURE_CLOUD_PROFILE=
GT_TENANT_ID=
GT_SPA_CLIENT_ID=
GT_API_AUDIENCE=
GT_API_SCOPE=
# Dedicated application database, never an exercise-target database.
# Managed identity example:
# GT_SQL_URL=mssql+pyodbc://SERVER.database.windows.net/gametheory?driver=ODBC+Driver+18+for+SQL+Server&authentication=ActiveDirectoryMsi&Encrypt=yes
GT_SQL_URL=
GT_BLOB_URL=
GT_BLOB_CONTAINER=assets
# Local emulator only; leave empty for managed identity.
GT_BLOB_CONNECTION_STRING=
GT_SCHEDULER_ENDPOINT=
GT_SCHEDULER_TASKHUB=gametheory
GT_SCHEDULER_EMULATOR=false
GT_FOUNDRY_PROJECT_ENDPOINT=
GT_MODEL_DEPLOYMENT=
GT_PLANNING_ENABLED=false
GT_MAX_UPLOAD_BYTES=10485760
